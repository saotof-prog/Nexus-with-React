# Backend
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# Email (Mailtrap) — https://mailtrap.io
#
# Option A — Email Testing (sandbox, recommandé en dev) :
#   SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=587 (ou 2525)
#   Credentials depuis : Email Testing → Inbox → SMTP
#   SMTP_FROM peut être n'importe quelle adresse
#
# Option B — Email Sending (production) :
#   SMTP_HOST=live.smtp.mailtrap.io  SMTP_PORT=587
#   SMTP_FROM = adresse sur un domaine vérifié (Sending → Domains)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM="NEXUS <noreply@example.com>"

# Frontend
FRONTEND_URL=http://localhost:5173
